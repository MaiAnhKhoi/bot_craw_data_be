# =====================================================================
# bot_craw_data — file cấu hình mẫu.
# Copy thành `.env` rồi sửa giá trị:   cp .env.example .env
# KHÔNG commit file `.env` thật (đã bị .gitignore chặn).
#
# Mọi biến có tiền tố `BCD_` và ánh xạ 1-1 với một field trong `app/core/config.py`.
# Tên sai/thừa thì bị BỎ QUA IM LẶNG (`extra="ignore"`) — gõ nhầm `BCD_PACE_MIN_SECOND`
# (thiếu chữ S) sẽ không có lỗi nào cả, chỉ là con bot chạy bằng giá trị mặc định.
#
# Giá trị dưới đây = đúng giá trị mặc định trong code, trừ `database_url` (trỏ vào cổng
# Postgres mà docker-compose.yml publish ra host, để chạy uvicorn/alembic bằng tay).
# Chạy bằng `docker compose up` thì KHÔNG CẦN file này: compose đã có sẵn mặc định an toàn.
# =====================================================================

# --- Ứng dụng ---
BCD_APP_NAME=bot_craw_data
BCD_VERSION=0.1.0
# true = trả traceback chi tiết khi lỗi. ĐỂ false ở bản chạy thật.
BCD_DEBUG=true
BCD_API_PREFIX=/api/v1
# Origin của frontend được phép gọi API, nhiều giá trị phân tách bằng dấu phẩy.
# Deploy thật thì đổi thành địa chỉ máy/tên miền thật, KHÔNG dùng dấu *
BCD_CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
# Khớp với service `db` trong docker-compose.yml (publish 5432 ra host).
# Chạy TRONG docker thì hostname phải là `db`, không phải localhost — compose tự lo việc đó.
BCD_DATABASE_URL=postgresql+psycopg://botcraw:botcraw@localhost:5432/botcraw
# Pool kết nối. Công cụ nội bộ vài người dùng + 1 worker: 10 là thừa. Tăng lên chỉ có
# nghĩa khi Postgres còn rảnh mà API nghẽn ở chỗ chờ kết nối.
BCD_DB_POOL_SIZE=10
BCD_DB_MAX_OVERFLOW=10

# --- Bảo mật ---
# Sinh secret mới: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Giữ nguyên chuỗi mặc định = ai đọc được repo cũng tự ký được token admin.
BCD_JWT_SECRET_KEY=doi-secret-nay-truoc-khi-chay-that
BCD_JWT_ALGORITHM=HS256
# 720 phút = 12 giờ: đủ một ca làm việc, khỏi phải đăng nhập lại giữa chừng khi đang theo
# dõi một job cào chạy vài tiếng.
BCD_ACCESS_TOKEN_EXPIRE_MINUTES=720
# Tài khoản quản trị đầu tiên — CHỈ dùng lúc khởi tạo. Đổi mật khẩu ngay sau lần đăng nhập
# đầu; `admin12345` là giá trị demo, không phải mật khẩu.
BCD_ADMIN_USERNAME=admin
BCD_ADMIN_PASSWORD=admin12345

# --- Trình duyệt ---
# playwright  = bản chuẩn, Chromium đã nhúng sẵn trong image nền -> chạy được ngay.
# patchright  = bản đã vá các dấu vết CDP mà Google dùng để nhận diện trình duyệt tự động.
#   Cả hai đều chạy được NGAY trong image: patchright 1.63 là bản fork của playwright 1.63
#   nên dùng CHUNG đúng revision Chromium có sẵn ở /ms-playwright (đã thử trong container).
#   ⚠️ Điều đó chỉ đúng khi hai gói CÙNG số phiên bản — vì vậy requirements.txt ghim cả hai
#   ở `>=1.63,<1.64`. Nếu có lúc phải để lệch phiên bản, patchright sẽ đòi revision riêng và
#   worker chết lúc launch với "Executable doesn't exist"; khi đó phải cài thêm một lần
#   (ghi vào image, cần quyền root):
#       docker compose run --rm --user root worker python -m patchright install chromium
BCD_BROWSER_ENGINE=playwright
# false = hiện cửa sổ trình duyệt (chỉ chạy được NGOÀI docker, container không có X server).
BCD_HEADLESS=true
# Hồ sơ trình duyệt: cookie + trạng thái đồng ý cookie của Google. Giữ được hồ sơ này nghĩa
# là mỗi lần khởi động ta vẫn là "máy cũ" với Google; xoá đi là quay về vạch xuất phát và
# bị soi kỹ hơn. Thư mục nằm trong `var/` nên được mount ra host, sống sót qua build lại.
BCD_BROWSER_PROFILE_DIR=var/browser_profile
# Ngôn ngữ / quốc gia / locale / múi giờ của phiên trình duyệt. Bốn giá trị này phải NHẤT
# QUÁN với nhau: một trình duyệt khai locale vi-VN mà múi giờ UTC là dấu hiệu bất thường
# kinh điển của bot.
BCD_HL=vi
BCD_GL=vn
BCD_LOCALE=vi-VN
BCD_TIMEZONE=Asia/Ho_Chi_Minh
BCD_VIEWPORT_WIDTH=1366
BCD_VIEWPORT_HEIGHT=900
# Trần chờ một thao tác trang (ms). Quá ngắn -> báo lỗi oan lúc mạng chậm; quá dài -> một
# trang treo giữ luồng cào duy nhất hàng phút.
BCD_PAGE_TIMEOUT_MS=30000

# =====================================================================
# --- NHỊP CÀO ---
# ★★ ĐÂY LÀ LỚP CHỐNG CHẶN CHÍNH CỦA HỆ THỐNG. Bot chạy MỘT LUỒNG, bằng ĐÚNG IP mạng của
# văn phòng và KHÔNG DÙNG PROXY — nghĩa là không có gì để thay khi bị Google để ý: IP đó
# cũng là IP mọi người dùng để vào Gmail, Drive, Maps. Bị gắn cờ là cả văn phòng ăn CAPTCHA.
#
# Vì vậy CHẠY CHẬM LÀ CỐ Ý, không phải chưa kịp tối ưu. Tăng tốc bằng cách giảm mấy con số
# dưới đây là đánh đổi: nhanh hơn vài giờ, đổi lấy rủi ro mất quyền truy cập cả ngày (và
# một hồ sơ trình duyệt đã bị đánh dấu thì xoá đi cũng không sạch). Muốn nhanh hơn thì phải
# đổi kiến trúc (proxy dân cư, nhiều máy), không phải đổi mấy dòng này.
# =====================================================================
# Nghỉ ngẫu nhiên giữa hai thao tác (giây). NGẪU NHIÊN mới là điểm mấu chốt: người thật
# không bao giờ click đều tăm tắp mỗi 5.0 giây, và một chuỗi khoảng cách đều nhau là thứ dễ
# phát hiện nhất trong log phía máy chủ.
BCD_PACE_MIN_SECONDS=4.0
BCD_PACE_MAX_SECONDS=8.0
# Trần khi bot TỰ GIẢM TỐC vì nghi bị theo dõi (thấy CAPTCHA, trang lạ, kết quả rỗng bất
# thường). Nhịp giãn dần tới mức này rồi dừng — không giãn vô hạn, nếu không job sẽ "sống"
# mà cả ngày không cào thêm được dòng nào.
BCD_PACE_CEILING_SECONDS=45.0
# Nghỉ giữa hai lần cuộn danh sách kết quả. Cuộn liên tục không nghỉ là hành vi của script,
# và cũng khiến trang chưa kịp nạp thêm kết quả -> parser đọc thiếu.
BCD_SCROLL_PAUSE_MIN=1.5
BCD_SCROLL_PAUSE_MAX=3.0
# Khi đã CHẮC CHẮN bị chặn: nghỉ hẳn 3600 giây (1 giờ). Thử lại ngay sau khi bị chặn là
# cách nhanh nhất để biến một lần nghi ngờ tạm thời thành một lệnh cấm dài hạn.
BCD_BLOCK_BACKOFF_SECONDS=3600
# Chạy êm bao nhiêu TRANG thì được nới nhịp về mức bình thường. Nới theo số trang thành
# công (bằng chứng thật) chứ không theo đồng hồ.
BCD_BLOCK_PROBE_AFTER_PAGES=200
# Giờ nghỉ đêm (giờ địa phương, 2h–6h): không văn phòng nào tra Google Maps liên tục lúc
# 3 giờ sáng. Đặt hai giá trị BẰNG NHAU để tắt hẳn.
BCD_NIGHT_REST_START=2
BCD_NIGHT_REST_END=6
# Worker hỏi DB "có job mới không?" mỗi ngần này giây. Hạ xuống 1-2s chỉ để job khởi động
# nhanh hơn vài giây, đổi lại là hàng nghìn query rỗng mỗi giờ.
BCD_WORKER_POLL_SECONDS=20
# Worker ghi nhịp tim vào DB mỗi ngần này giây; API dựa vào đó để báo "worker còn sống".
BCD_HEARTBEAT_SECONDS=30

# --- Kiểm tra website (httpx, KHÔNG mở trình duyệt) ---
# Đây là request tới website CỦA DOANH NGHIỆP, không phải tới Google — nên được phép chạy
# song song và nhanh, không dính nhịp chống chặn ở trên.
BCD_WEBSITE_CHECK_TIMEOUT=8.0
BCD_WEBSITE_CHECK_CONCURRENCY=8

# --- Xuất file ---
# Thư mục chứa file xuất, nằm trong `var/` nên được mount ra host (file không mất khi dựng
# lại container) — nhưng cũng nghĩa là DỮ LIỆU KHÁCH HÀNG nằm thẳng trên đĩa máy văn phòng.
BCD_EXPORT_DIR=var/exports
# Trần số dòng một lần xuất. Vượt trần -> API trả lỗi EXPORT_TOO_LARGE thay vì âm thầm ngốn
# hết RAM rồi bị OOM-kill giữa lúc đang ghi file.
BCD_EXPORT_MAX_ROWS=100000

# =====================================================================
# --- AI SINH TỪ KHOÁ BẢN ĐỊA (tuỳ chọn) ---
# Vấn đề nó giải: từ khoá tiếng Việt gần như vô dụng ngoài Việt Nam. Đo thực tế,
# "xuất nhập khẩu trái cây Bangkok" chỉ ra 2 kết quả và cả hai đều ở TP.HCM.
# Cùng ý đó viết "fruit wholesaler" với gl=th thì ra đầy kết quả Thái Lan.
#
# AI CHỈ chạy khi bạn bấm nút ở màn tạo job, và kết quả luôn hiện ra cho bạn sửa
# trước khi chạy. Worker cào không bao giờ gọi AI. Để trống khoá thì nút bị ẩn và
# mọi thứ chạy y như cũ.
# =====================================================================
BCD_AI_ENABLED=true
# Lấy khoá tại https://console.anthropic.com — để trống là tắt tính năng.
BCD_AI_API_KEY=
# Tác vụ chỉ là tra cụm từ tìm kiếm bản địa nên model nhẹ là đủ và rẻ.
BCD_AI_MODEL=claude-haiku-4-5
# Số cụm từ tối đa sinh cho mỗi quốc gia, và trần số quốc gia cho một lần gọi.
BCD_AI_MAX_KEYWORDS=4
BCD_AI_MAX_COUNTRIES=40

# --- AI phân xử thẻ ranh giới lúc quét ---
#
# NGOẠI LỆ DUY NHẤT của luật "worker không gọi AI" ở trên. Bộ lọc ngành nghề tự
# quyết được khoảng 90% số thẻ bằng cách so nhãn Google gắn với danh mục cho
# phép; phần còn lại là những ca nhãn vô nghĩa ("Company", "General store") hoặc
# nhãn rõ ràng khác ngành mà tên lại dính chữ. Những ca đó được gửi cho AI nhìn
# tên + nhãn + địa chỉ rồi phán giữ hay loại.
#
# Tắt đi (`false`) thì hệ thống vẫn chạy bình thường: thẻ ranh giới được GIỮ LẠI
# kèm dấu nghi ngờ thay vì bị bỏ. Không có đường nào để AI làm chết một lượt quét.
BCD_AI_JUDGE_ENABLED=true
# Trần số thẻ gửi cho AI trong MỘT truy vấn. Đây là cầu chì cho trường hợp danh
# mục ngành nghề bị khai sai khiến gần như mọi thẻ rơi vào diện ranh giới —
# phần vượt trần được giữ lại kèm dấu nghi ngờ, không phải vứt đi.
BCD_AI_JUDGE_MAX_PER_QUERY=60

# =====================================================================
# --- SAO LƯU DATABASE (service `backup`) ---
# Hai biến này do `scripts/backup_loop.sh` đọc, ứng dụng Python KHÔNG đọc.
#
# ★ Lịch sao lưu ở đây KHÔNG phải cron. Máy này là máy văn phòng, tối bị tắt, nên hẹn
# đúng 3h sáng thì hôm nào máy tắt là hôm đó mất trắng một bản mà không ai hay. Thay vào
# đó container hỏi mỗi 30 phút "bản gần nhất bao nhiêu tuổi" và chạy bù ngay khi quá
# ngưỡng — bật máy lúc 9h sáng là 9h có bản sao lưu.
#
# File dump nằm ở thư mục `backups/` ngay cạnh repo, mở bằng Explorer được.
# Cách restore: docs/BACKUP.md
# =====================================================================
# Bản sao lưu cũ hơn ngần này giờ thì chạy bù. 24 = mỗi ngày một bản. Hạ xuống 12 nếu
# một ngày dữ liệu cào là quá nhiều để chấp nhận mất.
BCD_BACKUP_EVERY_HOURS=24
# Giữ lại bao nhiêu bản gần nhất, cũ hơn thì xoá. 14 bản ~ hai tuần, đủ để phát hiện ra
# một lỗi âm thầm (xoá nhầm, ghi hỏng) rồi lùi về trước lúc nó xảy ra. Mỗi bản chỉ vài
# MB nên tăng lên cũng không tốn gì đáng kể.
BCD_BACKUP_KEEP=14

# =====================================================================
# --- CHỈ DÀNH CHO DOCKER COMPOSE ---
# Bốn biến dưới đây KHÔNG có trong `app/core/config.py` và ứng dụng KHÔNG đọc chúng
# (`extra="ignore"` bỏ qua im lặng). Chúng chỉ để `docker-compose*.yml` nội suy.
# =====================================================================
# Cổng publish ra host. Máy đã có sẵn Postgres/dịch vụ khác chiếm cổng thì đổi ở đây, KHÔNG
# sửa file compose (cổng bên trong mạng compose vẫn là 5432/8000).
# Giây chờ kết nối Postgres trước khi báo lỗi (tối thiểu 2).
BCD_DB_CONNECT_TIMEOUT=5

BCD_DB_PORT=5432
BCD_API_PORT=8000
# Cổng của giao diện web (service `web` trong docker-compose.web.yml). Đây là địa chỉ
# mọi người trong văn phòng mở trên trình duyệt.
BCD_WEB_PORT=3000

# ★ CHẠY CẢ BACKEND LẪN GIAO DIỆN BẰNG MỘT LỆNH `docker compose up -d --build`.
# Bỏ dấu # ở dòng dưới khi repo frontend (bot_craw_data_fe) đã được clone NẰM CẠNH repo này.
# Không bật thì `docker compose up` chỉ dựng backend, và muốn kèm web phải gõ đầy đủ:
#     docker compose -f docker-compose.yml -f docker-compose.web.yml up -d --build
# COMPOSE_FILE=docker-compose.yml:docker-compose.web.yml

# ★ CHỈ dùng cho `docker-compose.prod.yml`, và ở đó là BẮT BUỘC (thiếu thì compose dừng ngay).
# Bản dev cố tình ghim mật khẩu `botcraw` để máy mới clone chạy được luôn.
# BCD_DB_PASSWORD=doi-mat-khau-nay
# Địa chỉ mà API bind ở bản prod. 127.0.0.1 = chỉ máy này gọi được (mặc định, an toàn nhất).
# Đổi thành 0.0.0.0 nếu máy khác trong văn phòng cần gọi — lúc đó chỉ còn JWT che chắn.
# BCD_API_BIND=127.0.0.1
